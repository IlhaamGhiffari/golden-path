---
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = [
  {
    href: '/blog/deploying-like-a-platform-product',
    title: 'Deploying my portfolio like a platform product',
    excerpt: 'How this site ships: push to main → CI builds and scans → ArgoCD deploys to AKS. Zero manual steps.',
  },
  {
    href: '/blog/why-gitops',
    title: 'Why GitOps',
    excerpt: 'Declarative state, self-healing clusters, and an audit trail — what GitOps actually buys you.',
  },
];
---
<BaseLayout title="Blog — Ilhaam Ghiffari" description="Blog by Ilhaam Ghiffari — platform engineering notes.">
  <section>
    <h1>Blog</h1>
    <p class="sub">Notes from building this site — the pipeline is the product.</p>

    <ul class="blog-list">
      {
        posts.map((post) => (
          <li>
            <h3><a href={post.href}>{post.title}</a></h3>
            <p>{post.excerpt}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
